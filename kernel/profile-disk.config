# Profile "disk": block layer, virtio-blk, dm-crypt, dm-verity and erofs. For a verity-protected
# root on an attached disk or an encrypted local volume.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_XTS=y
CONFIG_EROFS_FS=y
CONFIG_MISC_FILESYSTEMS=y

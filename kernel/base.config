# Profile "minimal", applied on top of `make allnoconfig`. Every line is asserted at build time.
# Devices: virtio-net and the SEV guest driver. No block layer, no modules.

# Machine
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
# AMD only: SEV-SNP exists on no other vendor. PROCESSOR_SELECT makes the vendor options visible.
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_AMD=y
CONFIG_CPU_SUP_INTEL=n
CONFIG_CPU_SUP_HYGON=n
CONFIG_CPU_SUP_CENTAUR=n
CONFIG_CPU_SUP_ZHAOXIN=n
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
# No KVM paravirtual guest interfaces: kvm-clock is a page the host writes; with it off the
# clocksource is the TSC, which is host-proof when the guest is launched with Secure TSC.
CONFIG_KVM_GUEST=n
CONFIG_X86_X2APIC=y
# No machine-check handler: a #MC the host injects panics the guest instead of running the handler on host-supplied MSR values.
CONFIG_X86_MCE=n
CONFIG_CPU_MITIGATIONS=y
# Every x86 mitigation in 6.18 that applies to an AMD guest. allnoconfig leaves them off. The Intel-only ones
# (GDS, IBRS_ENTRY, ITS, L1TF, MDS, MMIO_STALE_DATA, RFDS, SPECTRE_BHI, SRBDS, TAA, CALL_DEPTH_TRACKING) do not
# exist without CPU_SUP_INTEL; VMSCAPE needs KVM host support.
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_TSA=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_JUMP_LABEL=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_250=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
# Timers: local APIC and TSC. The ACPI PM timer and the /dev/hpet device are off; HPET_TIMER is forced on x86-64 and serves TSC calibration.
CONFIG_X86_PM_TIMER=n
CONFIG_HPET=n
CONFIG_CPU_IDLE=y
CONFIG_X86_UMIP=y
CONFIG_ZONE_DMA=y
CONFIG_ACPI=y

# Boot: EFI stub, initramfs-only root, zstd
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_RUNTIME_MAP=n
CONFIG_UNACCEPTED_MEMORY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n

# SEV-SNP guest and /dev/sev-guest (needs AES-GCM for the guest-firmware channel)
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_VIRT_DRIVERS=y
CONFIG_SEV_GUEST=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y

# Userland facilities
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=n
CONFIG_BUG=y
CONFIG_KALLSYMS=n
CONFIG_IKCONFIG=n
CONFIG_COMPAT=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n

# Memory
CONFIG_SWAP=n
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_SPARSEMEM_VMEMMAP=y

# PCI and virtio; virtio-net is the only network device
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_CONSOLE=n
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VIRTIO_MMIO=n
CONFIG_VSOCKETS=n
CONFIG_VHOST_MENU=n
CONFIG_HW_RANDOM=n

# Networking: IPv4 with kernel DHCP (ip=dhcp on the command line), IPv6, unix sockets
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=n
CONFIG_IP_PNP_RARP=n
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=n
CONFIG_IP_MULTICAST=n
CONFIG_INET_DIAG=n
CONFIG_SYN_COOKIES=y

# Filesystems: RAM only
CONFIG_BLOCK=n
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MISC_FILESYSTEMS=n

# TTY core only; console drivers are in debug.config
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=n
CONFIG_LEGACY_PTYS=n
CONFIG_VT=n
CONFIG_SERIO=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_USB_SUPPORT=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n
CONFIG_RTC_CLASS=n
CONFIG_WATCHDOG=n
CONFIG_HWMON=n
CONFIG_THERMAL=n
CONFIG_MD=n
CONFIG_ATA=n
CONFIG_SCSI=n
CONFIG_ETHERNET=n
CONFIG_WLAN=n

# Attack surface
CONFIG_MODULES=n
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_X86_MSR=n
CONFIG_X86_CPUID=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_FTRACE=n
CONFIG_BPF_SYSCALL=n
CONFIG_IO_URING=n
CONFIG_USERFAULTFD=n
CONFIG_KCMP=n
CONFIG_PROFILING=n
# CONFIG_PERF_EVENTS is selected by the x86-64 architecture and cannot be disabled.
CONFIG_NAMESPACES=n
CONFIG_CGROUPS=n
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_LDISC_AUTOLOAD=n
CONFIG_FW_LOADER=n
CONFIG_DEBUG_FS=n
CONFIG_SECURITYFS=n
CONFIG_HOTPLUG_PCI=n
CONFIG_ACPI_HOTPLUG_MEMORY=n
# No calls into firmware after boot, no PCI quirk table, no io_submit, no rseq, no port 0x80 delays.
CONFIG_EFI_DISABLE_RUNTIME=y
CONFIG_PCI_QUIRKS=n
CONFIG_AIO=n
CONFIG_RSEQ=n
CONFIG_IO_DELAY_NONE=y
CONFIG_SECCOMP=y

# Hardening
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_PANIC_ON_OOPS=y
# The kernel never executes a userspace program on its own; registers are zeroed on function return.
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_PANIC_TIMEOUT=-1
